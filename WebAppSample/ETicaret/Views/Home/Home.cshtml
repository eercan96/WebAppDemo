@model List<Urunler>

@{
    
}

<style>
    img {
        width: 500px;
        height: 500px;
    }
</style>

<div class="row">
    <div class="col-md-8">
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-md-5">
                    <img src="@item.Resim" alt="Ürün bulunamadı" />
                </div>
                <h3 class="text-black" style="font-weight:700">@item.UrunAdi</h3>
                <h3 class ="text-danger" style="font-weight:700">@item.BirimFiyati.ToString("#,##0.00") $</h3>
                <div class="form-group mt-2">
                    <bottun class="btn btn-primary btn-block">Sepete Ekle</bottun>
                </div>
                
            }           
            
        </div>
    </div>
    <div class="col-md-4">
        <table class="table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Ürün Adı</th>
                    <th>Adet</th>
                    <th>Birim Fiyatı</th>
                    <th>Toplam Tutar</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <th>1</th>
                    <th>Domates</th>
                    <th>3</th>
                    <th>10</th>
                    <th>30</th>
                    <th>
                        <button class="btn btn-danger">Sil</button>
                    </th>
                </tr>
            </tbody>
        </table>
        <hr />
        <label class="form-control">Toplam Tutar</label>
        <bottun class="btn btn-warning mt-2">Ödeme Yap</bottun>
    </div>
</div>