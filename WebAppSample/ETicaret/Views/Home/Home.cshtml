@using ETicaret.Dto;
@model HomeDto;

@{
    int id = 0;

    decimal toplam = 0;
    foreach (var item in Model.Sepetim)
    {
        toplam =toplam + item.Toplam;
    }

}

<style>
    img {
        width: 400px;
        height: 400px;
    }
</style>

<div class="row">
    <div class="col-md-8">
        <div class="row">
            @foreach (var item in Model.Urunlerim)
            {
                <form action="/Home/SepeteEkle" method="post">
                    <div class="col-md-4">
                        <input hidden="hidden" name="id" value="@item.Id" >
                        <img src="@item.Resim" alt="Ürün bulunamadı" />
                    </div>
                    <h3 class="text-black" style="font-weight:700">@item.UrunAdi</h3>
                    <h3 class="text-danger" style="font-weight:700">@item.BirimFiyati.ToString("#,##0.00") $</h3>
                    <input class="form-control" type="number" name="adet" value="1">
                    <div class="form-group mt-2">
                        <button type="submit" class="btn btn-primary btn-block">Sepete Ekle</button>
                    </div>

                </form>
            }

        </div>
    </div>
    <div class="col-md-4">
        <table class="table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Ürün Adı</th>
                    <th>Adet</th>
                    <th>Birim Fiyatı</th>
                    <th>Toplam Tutar</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Sepetim)
                {

                    id++;
                    <tr>
                        <th>@id</th>
                        <th>@item.UrunAdi</th>
                        <th>@item.Adet</th>
                        <th>@item.BirimFiyati.ToString("#,##0.00")</th>
                        <th>@item.Toplam.ToString("#,##0.00")</th>
                        <th>
                            <form action="/Home/SepettekiUrunuSil" method="post">
                                <input hidden="hidden" name="id" value="@item.Id" />
                            <button type="submit" class="btn btn-danger">Sil</button>
                            </form>
                        </th>
                    </tr>

                }

            </tbody>
        </table>
        <hr />
        <label class="form-control">Toplam Tutar: @toplam.ToString("#,##0.00")</label>
        <h2 class="text-danger">@TempData["odeme"]</h2>
        <form action="/Home/OdemeYap" method="post">
            <button type="submit" class="btn btn-warning mt-2">Ödeme Yap</button>
        </form>
    </div>
</div>